pr #431 by @devon: paginate the audit log endpoint

diff --git a/src/api/audit.ts b/src/api/audit.ts
@@ -3,12 +3,24 @@
-export async function listAuditEvents(): Promise<AuditEvent[]> {
-  return db.auditEvents.findAll({ order: [['createdAt', 'DESC']] });
+const PAGE_SIZE = 50;
+
+export async function listAuditEvents(page: number): Promise<Page<AuditEvent>> {
+  const offset = page * PAGE_SIZE;
+  const rows = await db.auditEvents.findAll({
+    order: [['createdAt', 'DESC']],
+    limit: PAGE_SIZE,
+    offset,
+  });
+  const total = await db.auditEvents.count();
+  return {
+    items: rows,
+    page,
+    hasMore: offset + PAGE_SIZE < total,
+  };
 }
diff --git a/src/api/routes/audit.ts b/src/api/routes/audit.ts
@@ -8,6 +8,7 @@
-  const events = await listAuditEvents();
-  res.json(events);
+  const page = Number(req.query.page ?? 1);
+  const result = await listAuditEvents(page);
+  res.json(result);
diff --git a/src/api/audit.test.ts b/src/api/audit.test.ts
@@ -1,3 +1,12 @@
+it('returns the first page with hasMore when more rows exist', async () => {
+  await seedAuditEvents(120);
+  const result = await listAuditEvents(0);
+  expect(result.items).toHaveLength(50);
+  expect(result.hasMore).toBe(true);
+});

notes for the reviewer: the route defaults `page` to 1 while `listAuditEvents` treats page 0 as the first page, so the default request skips the first 50 rows. the test only exercises page 0 directly. the hasMore computation and the descending order are correct, and splitting the page shape into a `Page<T>` type is a clean move.
