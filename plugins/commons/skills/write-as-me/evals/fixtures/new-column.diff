+import { Avatar } from '@ui/avatar';
+import type { ColumnDef } from '../types';
+
+export interface AvatarColumnOptions<Row> {
+  readonly getName: (row: Row) => string;
+  readonly getImageUrl: (row: Row) => string | undefined;
+  readonly size?: 'sm' | 'md';
+  readonly header?: string;
+}
+
+export function createAvatarColumn<Row>(opts: AvatarColumnOptions<Row>): ColumnDef<Row> {
+  return {
+    id: 'avatar',
+    header: opts.header ?? '',
+    width: opts.size === 'sm' ? 40 : 56,
+    cell: (row) => (
+      <Avatar
+        name={opts.getName(row)}
+        src={opts.getImageUrl(row)}
+        size={opts.size ?? 'md'}
+      />
+    ),
+  };
+}
