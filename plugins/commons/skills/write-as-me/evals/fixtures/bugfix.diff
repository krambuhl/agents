diff --git a/src/billing/proration.ts b/src/billing/proration.ts
index 3f1c2a9..8d4e0b1 100644
--- a/src/billing/proration.ts
+++ b/src/billing/proration.ts
@@ -12,7 +12,9 @@ export function prorate(amountCents: number, daysUsed: number, daysInPeriod: number): number {
-  return Math.round((amountCents * daysUsed) / daysInPeriod);
+  // round half up in cents so a 30/31 split never drops a cent
+  const scaled = (amountCents * daysUsed) / daysInPeriod;
+  return Math.floor(scaled + 0.5);
 }
