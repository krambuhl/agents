{
  "description": "Skill-activation log and gate for the voice skills. The log records every skill activation; the gate blocks PR-thread posts until pr-comments has loaded in the session, and commits or PR creation until write-as-me has.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/log-skill-activation.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/log-skill-activation.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__.*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/require-skill.sh" }
        ]
      }
    ]
  }
}
